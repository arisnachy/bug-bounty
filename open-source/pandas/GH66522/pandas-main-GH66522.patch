+    def test_online_single_column_frame(self):
+        obj = DataFrame({"a": range(5)})
+        expected = obj.ewm(0.5).mean()
+        online_ewm = obj.head(2).ewm(0.5).online()
+
+        result = online_ewm.mean()
+        tm.assert_equal(result, expected.head(2))
+
+        result = online_ewm.mean(update=obj.tail(3))
+        tm.assert_equal(result, expected.tail(3))
+
+    def test_online_ewma_uses_row_deltas(self):
+        ewm_func = generate_online_numba_ewma_func(
+            nogil=False,
+            parallel=False,
+        )
+        values = np.array(
+            [
+                [1.0, 10.0],
+                [3.0, 30.0],
+                [5.0, 50.0],
+            ]
+        )
+        result, old_wt = ewm_func(
+            values,
+            np.array([1.0, 2.0]),
+            1,
+            0.5,
+            1.0,
+            np.ones(2),
+            True,
+            False,
+        )
+
+        expected = np.array(
+            [
+                [1.0, 10.0],
+                [7.0 / 3.0, 70.0 / 3.0],
+                [47.0 / 11.0, 470.0 / 11.0],
+            ]
+        )
+        np.testing.assert_allclose(result, expected, rtol=1e-12, atol=0)
+        np.testing.assert_allclose(
+            old_wt, np.array([1.375, 1.375]), rtol=1e-12, atol=0
+        )
+
     @pytest.mark.slow
     @pytest.mark.parametrize(
